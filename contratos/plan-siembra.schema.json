{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrohive.example/contratos/plan-siembra.schema.json",
  "title": "PlanSiembra",
  "description": "Rotacion que arma el selector 'what if': que cultivo va en cada ciclo y, opcionalmente, en cada celda. Que los ciclos sean cronologicos y no se traslapen lo valida el motor (doc 04), no el schema.",
  "type": "object",
  "required": [
    "meta",
    "rotacionId",
    "parcelaId",
    "calendarioLocal",
    "asignacionClima",
    "ciclos",
    "porCelda"
  ],
  "properties": {
    "meta": {
      "$ref": "comun.schema.json#/$defs/meta"
    },
    "rotacionId": {
      "$ref": "comun.schema.json#/$defs/idRotacion"
    },
    "nombre": {
      "type": "string"
    },
    "parcelaId": {
      "type": "string"
    },
    "calendarioLocal": {
      "description": "Calendario local usado para sugerir las fechas, o constancia de que no hay.",
      "oneOf": [
        {
          "title": "ConCalendarioLocal",
          "type": "object",
          "required": [
            "calendarioId"
          ],
          "properties": {
            "calendarioId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "title": "SinCalendarioLocal",
          "type": "object",
          "required": [
            "sinCalendarioLocal",
            "motivo"
          ],
          "properties": {
            "sinCalendarioLocal": {
              "const": true
            },
            "motivo": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "asignacionClima": {
      "description": "Como se asigna clima a cada ciclo (doc 05, paso 2). Decidido el 14/11 (A2.8): temporada_tipica, cada ciclo en su temporada tipica (PV u OI) dentro del anio del escenario.",
      "const": "temporada_tipica"
    },
    "ciclos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ciclo"
      }
    },
    "porCelda": {
      "description": "Solo si se pinta por bloques ([EN EVENTO]); null si toda la parcela sigue los ciclos generales. Clave: id de celda; valor: cultivos que reemplazan a los generales en esa celda.",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "$ref": "comun.schema.json#/$defs/idCelda"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/cicloCelda"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ciclo": {
      "title": "Ciclo",
      "type": "object",
      "required": [
        "ciclo",
        "cultivo",
        "temporada",
        "siembra",
        "porQue"
      ],
      "properties": {
        "ciclo": {
          "type": "integer",
          "minimum": 1
        },
        "cultivo": {
          "$ref": "comun.schema.json#/$defs/idCultivo"
        },
        "siembra": {
          "description": "Fecha de siembra elegida por el usuario. El anio puede ser relativo al escenario (asignacionClima = temporada_tipica).",
          "$ref": "comun.schema.json#/$defs/fecha"
        },
        "temporada": {
          "$ref": "comun.schema.json#/$defs/temporada"
        },
        "porQue": {
          "description": "Explicacion visible en la interfaz de por que se sugiere o se eligio esa fecha y de donde sale (calendario local y su fuente, o eleccion libre del usuario).",
          "type": "string",
          "minLength": 1
        },
        "dentroDeVentana": {
          "description": "true si la fecha cae en la ventana del calendario local; null si no hay calendario o ventana.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cicloCelda": {
      "title": "CicloCelda",
      "type": "object",
      "required": [
        "ciclo",
        "cultivo"
      ],
      "properties": {
        "ciclo": {
          "type": "integer",
          "minimum": 1
        },
        "cultivo": {
          "$ref": "comun.schema.json#/$defs/idCultivo"
        }
      },
      "additionalProperties": false
    }
  }
}
