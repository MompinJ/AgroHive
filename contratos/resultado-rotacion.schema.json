{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrohive.example/contratos/resultado-rotacion.schema.json",
  "title": "ResultadoRotacion",
  "description": "Metricas de una rotacion en los tres escenarios, peor caso, ranking y explicacion (doc 05, pasos 6 a 8). Criterio principal B (decidido el 14/11): puntaje compuesto por escenario, robustez = peor puntaje, minimax de arrepentimiento y desempate por promedio. El criterio A (solo pilar hidrico) se conserva como respaldo si los pilares 2 y 3 (A3.7) no llegan. Los null son huecos que el motor llena con valores calculados, nunca con numeros inventados.",
  "type": "object",
  "required": [
    "meta",
    "rotacionId",
    "estado",
    "porEscenario",
    "peorCaso",
    "arrepentimiento",
    "ponderacion",
    "ranking",
    "advertencias",
    "explicacion"
  ],
  "properties": {
    "meta": {
      "$ref": "comun.schema.json#/$defs/meta"
    },
    "rotacionId": {
      "$ref": "comun.schema.json#/$defs/idRotacion"
    },
    "estado": {
      "$ref": "comun.schema.json#/$defs/estado"
    },
    "filtroClima": {
      "title": "FiltroClima",
      "description": "Paso 7.1: true si alguna siembra cae fuera de ventana viable en todos los escenarios. null si no se pudo evaluar.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "cultivosNoRecomendados": {
      "description": "Cultivos de la rotacion que se muestran pero no se recomiendan en el lugar. Si hay alguno, la rotacion no puede ser EVALUABLE (queda EXPLORATORIO: se ilustra, no se recomienda).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/cultivoNoRecomendado"
      }
    },
    "porEscenario": {
      "title": "MetricasPorEscenario",
      "type": "object",
      "required": [
        "seco",
        "habitual",
        "lluvioso"
      ],
      "properties": {
        "seco": {
          "$ref": "#/$defs/metricasEscenario"
        },
        "habitual": {
          "$ref": "#/$defs/metricasEscenario"
        },
        "lluvioso": {
          "$ref": "#/$defs/metricasEscenario"
        }
      },
      "additionalProperties": false
    },
    "peorCaso": {
      "description": "Escenario en el que la rotacion sale peor segun el criterio de ranking; null si no es evaluable.",
      "oneOf": [
        {
          "$ref": "#/$defs/peorCaso"
        },
        {
          "type": "null"
        }
      ]
    },
    "arrepentimiento": {
      "description": "Criterio B: arrepentimiento maximo entre escenarios (mejor puntaje del escenario entre las rotaciones comparadas menos el puntaje de esta). null con el criterio A de respaldo o si no es evaluable.",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ponderacion": {
      "description": "Criterio B: pesos con que se combinan los pilares en el puntaje. null con el criterio A o si no es evaluable. Sin pesos con fuente o justificados, se usan pesos iguales declarados como SUPUESTO; nunca pesos inventados presentados como dato.",
      "oneOf": [
        {
          "$ref": "#/$defs/ponderacion"
        },
        {
          "type": "null"
        }
      ]
    },
    "ranking": {
      "description": "Posicion en el ranking de robustez; null si la rotacion no es evaluable o no se ha ordenado.",
      "oneOf": [
        {
          "$ref": "#/$defs/ranking"
        },
        {
          "type": "null"
        }
      ]
    },
    "advertencias": {
      "type": "array",
      "items": {
        "$ref": "comun.schema.json#/$defs/advertencia"
      }
    },
    "explicacion": {
      "$ref": "#/$defs/explicacion"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Una rotacion NO_EVALUABLE o ERROR_DATOS no tiene peor caso, arrepentimiento ni ranking.",
      "if": {
        "properties": {
          "estado": {
            "enum": [
              "NO_EVALUABLE",
              "ERROR_DATOS"
            ]
          }
        },
        "required": [
          "estado"
        ]
      },
      "then": {
        "properties": {
          "peorCaso": {
            "type": "null"
          },
          "arrepentimiento": {
            "type": "null"
          },
          "ranking": {
            "type": "null"
          },
          "ponderacion": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "Con el criterio B el resultado declara sus pesos y su arrepentimiento.",
      "if": {
        "properties": {
          "peorCaso": {
            "type": "object",
            "required": [
              "criterio"
            ],
            "properties": {
              "criterio": {
                "const": "B_minimax_arrepentimiento"
              }
            }
          }
        },
        "required": [
          "peorCaso"
        ]
      },
      "then": {
        "properties": {
          "ponderacion": {
            "type": "object"
          },
          "arrepentimiento": {
            "type": "number"
          }
        }
      }
    },
    {
      "description": "Una rotacion con cultivos no recomendados en el lugar no es EVALUABLE.",
      "if": {
        "properties": {
          "cultivosNoRecomendados": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "cultivosNoRecomendados"
        ]
      },
      "then": {
        "properties": {
          "estado": {
            "not": {
              "const": "EVALUABLE"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "criterioRanking": {
      "title": "CriterioRanking",
      "description": "B (principal): puntaje por escenario combinando pilares, robustez = peor puntaje, minimax de arrepentimiento, desempate por promedio. A (respaldo): menor exposicion hidrica en el peor caso, sin puntaje compuesto.",
      "type": "string",
      "enum": [
        "B_minimax_arrepentimiento",
        "A_exposicion_hidrica_peor_caso"
      ]
    },
    "pilarDeficitHidrico": {
      "title": "PilarDeficitHidrico",
      "description": "Pilar 1 (nucleo).",
      "type": "object",
      "required": [
        "estado",
        "proporcionDemandaNoCubierta",
        "diasDeficit",
        "diasDeficitEtapasSensibles"
      ],
      "properties": {
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "proporcionDemandaNoCubierta": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "diasDeficit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "diasDeficitEtapasSensibles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "deficitTotalMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "excesoTotalMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pilarCompatibilidadCiclo": {
      "title": "PilarCompatibilidadCiclo",
      "description": "Pilar 2: siembras en meses viables segun clima y calendario.",
      "type": "object",
      "required": [
        "estado",
        "siembrasFueraDeVentana"
      ],
      "properties": {
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "siembrasFueraDeVentana": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pilarProteccionSuelo": {
      "title": "PilarProteccionSuelo",
      "description": "Pilar 3: indice relativo de erosion y periodos de suelo desnudo; no son toneladas.",
      "type": "object",
      "required": [
        "estado",
        "indiceErosionRelativo",
        "diasSueloDesnudo"
      ],
      "properties": {
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "indiceErosionRelativo": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "diasSueloDesnudo": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pilarRiesgoCalor": {
      "title": "PilarRiesgoCalor",
      "type": "object",
      "required": [
        "estado",
        "diasEstresCalor"
      ],
      "properties": {
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "diasEstresCalor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pilarAporteIndirecto": {
      "title": "PilarAporteIndirecto",
      "description": "Reglas simples (leguminosa, cobertura, diversidad); no afirma nitrogeno medido.",
      "type": "object",
      "required": [
        "estado",
        "incluyeLeguminosa",
        "especiesDistintas"
      ],
      "properties": {
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "incluyeLeguminosa": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "especiesDistintas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "metricasEscenario": {
      "title": "MetricasEscenario",
      "type": "object",
      "required": [
        "anioReal",
        "estado",
        "pilares",
        "puntaje"
      ],
      "properties": {
        "anioReal": {
          "description": "Anio real del escenario, siempre visible.",
          "type": [
            "integer",
            "null"
          ]
        },
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "pilares": {
          "title": "Pilares",
          "type": "object",
          "required": [
            "deficitHidrico"
          ],
          "properties": {
            "deficitHidrico": {
              "$ref": "#/$defs/pilarDeficitHidrico"
            },
            "compatibilidadCiclo": {
              "$ref": "#/$defs/pilarCompatibilidadCiclo"
            },
            "proteccionSuelo": {
              "$ref": "#/$defs/pilarProteccionSuelo"
            },
            "riesgoCalor": {
              "$ref": "#/$defs/pilarRiesgoCalor"
            },
            "aporteIndirecto": {
              "$ref": "#/$defs/pilarAporteIndirecto"
            }
          },
          "additionalProperties": false
        },
        "puntaje": {
          "description": "Criterio B: puntaje compuesto del escenario, de 0 a 1 (mayor es mejor). La normalizacion de cada pilar se documenta en A4.2. null con el criterio A o si el escenario no es evaluable.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "peorCaso": {
      "title": "PeorCaso",
      "type": "object",
      "required": [
        "escenario",
        "criterio",
        "metrica",
        "valor"
      ],
      "properties": {
        "escenario": {
          "$ref": "comun.schema.json#/$defs/escenario"
        },
        "criterio": {
          "$ref": "#/$defs/criterioRanking"
        },
        "metrica": {
          "description": "Nombre de la metrica que define el peor caso, por ejemplo 'deficitHidrico.proporcionDemandaNoCubierta' o 'puntaje'.",
          "type": "string",
          "minLength": 1
        },
        "valor": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "ranking": {
      "title": "Ranking",
      "type": "object",
      "required": [
        "posicion",
        "de",
        "criterio"
      ],
      "properties": {
        "posicion": {
          "type": "integer",
          "minimum": 1
        },
        "de": {
          "description": "Total de rotaciones evaluables comparadas.",
          "type": "integer",
          "minimum": 1
        },
        "criterio": {
          "$ref": "#/$defs/criterioRanking"
        },
        "desempate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidencia": {
      "title": "Evidencia",
      "description": "Dato concreto que respalda la explicacion (anio real, lluvia, mes, deficit).",
      "type": "object",
      "required": [
        "texto",
        "fuente"
      ],
      "properties": {
        "texto": {
          "type": "string",
          "minLength": 1
        },
        "valor": {
          "type": [
            "number",
            "null"
          ]
        },
        "unidad": {
          "type": "string"
        },
        "fuente": {
          "$ref": "comun.schema.json#/$defs/fuente"
        }
      },
      "additionalProperties": false
    },
    "explicacion": {
      "title": "Explicacion",
      "description": "Tarjeta de la rotacion (doc 05, paso 8). Si la redacta un LLM, solo usa numeros ya calculados; siempre hay plantilla de respaldo.",
      "type": "object",
      "required": [
        "porQue",
        "evidencia",
        "beneficios",
        "huecos",
        "riesgos",
        "avisoExperto",
        "redactadaPor"
      ],
      "properties": {
        "porQue": {
          "type": "string"
        },
        "evidencia": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidencia"
          }
        },
        "beneficios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "huecos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riesgos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avisoExperto": {
          "description": "Aviso de validar con un experto local.",
          "type": "string",
          "minLength": 1
        },
        "redactadaPor": {
          "type": "string",
          "enum": [
            "plantilla",
            "llm"
          ]
        }
      },
      "additionalProperties": false
    },
    "ponderacion": {
      "title": "Ponderacion",
      "type": "object",
      "required": [
        "pesos",
        "etiqueta",
        "pilaresExcluidos",
        "nota"
      ],
      "properties": {
        "pesos": {
          "title": "PesosPilares",
          "description": "Peso de cada pilar que entra al puntaje (suman 1). Un pilar NO_EVALUABLE no lleva peso y va en pilaresExcluidos.",
          "type": "object",
          "minProperties": 1,
          "properties": {
            "deficitHidrico": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "compatibilidadCiclo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "proteccionSuelo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "riesgoCalor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "aporteIndirecto": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "etiqueta": {
          "description": "SUPUESTO: pesos iguales por defecto. USUARIO: prioridades del agricultor (F8). FUENTE: pesos con referencia.",
          "$ref": "comun.schema.json#/$defs/etiquetaProcedencia"
        },
        "fuente": {
          "$ref": "comun.schema.json#/$defs/fuente"
        },
        "pilaresExcluidos": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "deficitHidrico",
              "compatibilidadCiclo",
              "proteccionSuelo",
              "riesgoCalor",
              "aporteIndirecto"
            ]
          },
          "uniqueItems": true
        },
        "nota": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "etiqueta": {
            "const": "FUENTE"
          }
        },
        "required": [
          "etiqueta"
        ]
      },
      "then": {
        "required": [
          "fuente"
        ]
      }
    },
    "cultivoNoRecomendado": {
      "title": "CultivoNoRecomendado",
      "description": "Cultivo que se muestra en la rotacion pero no se recomienda en ese lugar (por ejemplo, la fuente no lo registra en el municipio).",
      "type": "object",
      "required": [
        "cultivo",
        "ciclos",
        "motivo",
        "fuente"
      ],
      "properties": {
        "cultivo": {
          "$ref": "comun.schema.json#/$defs/idCultivo"
        },
        "ciclos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "fuente": {
          "$ref": "comun.schema.json#/$defs/fuente"
        },
        "calendarioId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
