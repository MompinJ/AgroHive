{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrohive.example/contratos/serie-balance.schema.json",
  "title": "SerieBalance",
  "description": "Series del balance de agua (FAO-56 cap. 8) de una rotacion en un escenario, por ciclo: diaria en columnas y agregada por mes. La entrega el motor bajo demanda (A4.1, dashboard); la interfaz solo las grafica, no recalcula. Las fechas son las del plan; el clima de cada dia es el del anio real del escenario (fechaClima = fecha del clima del primer dia). Un ciclo NO_EVALUABLE o ERROR_DATOS no lleva series (columnas vacias y mensual vacio) y lleva motivo. Agregado en 0.11.0 (A4.1).",
  "type": "object",
  "required": [
    "meta",
    "rotacionId",
    "escenario",
    "anioReal",
    "estado",
    "unidades",
    "fuentes",
    "ciclos"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "comun.schema.json#/$defs/meta"
    },
    "rotacionId": {
      "$ref": "comun.schema.json#/$defs/idRotacion"
    },
    "escenario": {
      "$ref": "comun.schema.json#/$defs/escenario"
    },
    "anioReal": {
      "type": "integer",
      "minimum": 1981,
      "maximum": 2025
    },
    "estado": {
      "$ref": "comun.schema.json#/$defs/estado"
    },
    "motivo": {
      "type": "string",
      "minLength": 1
    },
    "unidades": {
      "description": "Unidades de cada columna (fijas).",
      "type": "object",
      "required": [
        "lluviaMm",
        "et0Mm",
        "etcMm",
        "etcAjMm",
        "drMm",
        "rawMm",
        "humedad",
        "percolacionMm",
        "deficitMm"
      ],
      "additionalProperties": false,
      "properties": {
        "lluviaMm": {
          "const": "mm/dia"
        },
        "et0Mm": {
          "const": "mm/dia"
        },
        "etcMm": {
          "const": "mm/dia"
        },
        "etcAjMm": {
          "const": "mm/dia"
        },
        "drMm": {
          "const": "mm"
        },
        "rawMm": {
          "const": "mm"
        },
        "humedad": {
          "const": "fraccion de TAW (0 a 1)"
        },
        "percolacionMm": {
          "const": "mm/dia"
        },
        "deficitMm": {
          "const": "mm/dia"
        }
      },
      "title": "UnidadesBalance"
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "comun.schema.json#/$defs/fuente"
      }
    },
    "ciclos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cicloSerie"
      }
    },
    "advertencias": {
      "type": "array",
      "items": {
        "$ref": "comun.schema.json#/$defs/advertencia"
      }
    }
  },
  "$defs": {
    "numerosDia": {
      "title": "ColumnaDiaria",
      "description": "Una columna diaria (mm o mm/dia). null si ese dia falta el dato de entrada; nunca se rellena con 0.",
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    },
    "cicloSerie": {
      "type": "object",
      "required": [
        "ciclo",
        "cultivo",
        "celdas",
        "estado",
        "desde",
        "fechaClima",
        "tawMm",
        "dias",
        "mensual"
      ],
      "additionalProperties": false,
      "properties": {
        "ciclo": {
          "type": "integer",
          "minimum": 1
        },
        "cultivo": {
          "$ref": "comun.schema.json#/$defs/idCultivo"
        },
        "celdas": {
          "description": "Celdas que siguen este cultivo en este ciclo (con porCelda puede haber varias series por ciclo).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "comun.schema.json#/$defs/idCelda"
          }
        },
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "desde": {
          "description": "Fecha del plan del primer dia (siembra).",
          "$ref": "comun.schema.json#/$defs/fecha"
        },
        "fechaClima": {
          "description": "Fecha del clima del escenario que corresponde al primer dia; null si el ciclo no se simulo.",
          "oneOf": [
            {
              "$ref": "comun.schema.json#/$defs/fecha"
            },
            {
              "type": "null"
            }
          ]
        },
        "tawMm": {
          "description": "Capacidad de la cubeta TAW = TAW por metro x Zr (mm); null si no se simulo.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "dias": {
          "description": "Columnas diarias alineadas: el indice i es el dia desde + i. Todas con el mismo largo: el schema no puede exigirlo; lo comprueba contratos/validar.mjs (chequeo extra) y lo garantiza el motor.",
          "type": "object",
          "required": [
            "lluviaMm",
            "et0Mm",
            "etcMm",
            "etcAjMm",
            "drMm",
            "rawMm",
            "humedad",
            "percolacionMm",
            "deficitMm"
          ],
          "additionalProperties": false,
          "properties": {
            "lluviaMm": {
              "description": "Lluvia del dia (mm/dia), del clima del escenario.",
              "$ref": "#/$defs/numerosDia"
            },
            "et0Mm": {
              "description": "Evapotranspiracion de referencia (mm/dia).",
              "$ref": "#/$defs/numerosDia"
            },
            "etcMm": {
              "description": "ETc = Kc x ET0 (mm/dia).",
              "$ref": "#/$defs/numerosDia"
            },
            "etcAjMm": {
              "description": "ETc ajustada por estres hidrico (mm/dia), FAO-56 ec. 80.",
              "$ref": "#/$defs/numerosDia"
            },
            "drMm": {
              "description": "Agotamiento de la zona radicular al final del dia (mm), FAO-56 ec. 85; entre 0 y TAW.",
              "$ref": "#/$defs/numerosDia"
            },
            "rawMm": {
              "description": "Agua facilmente aprovechable RAW = p x TAW (mm).",
              "$ref": "#/$defs/numerosDia"
            },
            "humedad": {
              "description": "Agua en la cubeta como fraccion de TAW (0 a 1), igual que resultado-celda.humedad.",
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "percolacionMm": {
              "description": "Percolacion profunda del dia (mm/dia), FAO-56 ec. 88.",
              "$ref": "#/$defs/numerosDia"
            },
            "deficitMm": {
              "description": "Deficit del dia: ETc no cubierta (mm/dia).",
              "$ref": "#/$defs/numerosDia"
            }
          },
          "title": "ColumnasDiarias"
        },
        "mensual": {
          "description": "Sumas por mes del plan (mm) y humedad media; mesClima es el mes del clima del escenario.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "mes",
              "mesClima",
              "dias",
              "lluviaMm",
              "et0Mm",
              "etcMm",
              "etcAjMm",
              "percolacionMm",
              "deficitMm",
              "humedadMedia"
            ],
            "additionalProperties": false,
            "properties": {
              "mes": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "mesClima": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "dias": {
                "type": "integer",
                "minimum": 1
              },
              "lluviaMm": {
                "type": "number",
                "minimum": 0
              },
              "et0Mm": {
                "type": "number",
                "minimum": 0
              },
              "etcMm": {
                "type": "number",
                "minimum": 0
              },
              "etcAjMm": {
                "type": "number",
                "minimum": 0
              },
              "percolacionMm": {
                "type": "number",
                "minimum": 0
              },
              "deficitMm": {
                "type": "number",
                "minimum": 0
              },
              "humedadMedia": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "title": "MesBalance"
          }
        }
      },
      "allOf": [
        {
          "description": "Un ciclo NO_EVALUABLE o ERROR_DATOS no lleva series y explica el motivo.",
          "if": {
            "properties": {
              "estado": {
                "enum": [
                  "NO_EVALUABLE",
                  "ERROR_DATOS"
                ]
              }
            },
            "required": [
              "estado"
            ]
          },
          "then": {
            "required": [
              "motivo"
            ],
            "properties": {
              "tawMm": {
                "type": "null"
              },
              "fechaClima": {
                "type": "null"
              },
              "mensual": {
                "type": "array",
                "maxItems": 0
              },
              "dias": {
                "type": "object",
                "properties": {
                  "lluviaMm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "et0Mm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "etcMm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "etcAjMm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "drMm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "rawMm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "humedad": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "percolacionMm": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "deficitMm": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      ],
      "title": "CicloSerieBalance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estado": {
            "not": {
              "const": "EVALUABLE"
            }
          }
        },
        "required": [
          "estado"
        ]
      },
      "then": {
        "required": [
          "motivo"
        ]
      },
      "description": "Si el documento no es EVALUABLE, explica el motivo."
    }
  ]
}
