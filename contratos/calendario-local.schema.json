{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrohive.example/contratos/calendario-local.schema.json",
  "title": "CalendarioLocal",
  "description": "Calendario agricola de un lugar (A0.6, V-20; decidido el 14/11): por cultivo y temporada (PV, OI), la ventana de siembra con su fuente (SIAP, INIFAP) y si el cultivo se registra en el lugar. Depende del lugar, no del cultivo: por eso no esta en el catalogo. Sin dato, NO_EVALUABLE con motivo.",
  "type": "object",
  "required": [
    "meta",
    "id",
    "ubicacion",
    "entradas"
  ],
  "properties": {
    "meta": {
      "$ref": "comun.schema.json#/$defs/meta"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "ubicacion": {
      "title": "UbicacionCalendario",
      "type": "object",
      "required": [
        "pais",
        "claveEstadoInegi",
        "estado",
        "claveMunicipioInegi",
        "municipio"
      ],
      "properties": {
        "pais": {
          "type": "string",
          "minLength": 1
        },
        "claveEstadoInegi": {
          "description": "Clave INEGI de la entidad (2 digitos).",
          "type": "string",
          "pattern": "^\\d{2}$"
        },
        "estado": {
          "type": "string",
          "minLength": 1
        },
        "claveMunicipioInegi": {
          "description": "Clave INEGI del municipio dentro de la entidad (3 digitos).",
          "type": "string",
          "pattern": "^\\d{3}$"
        },
        "municipio": {
          "type": "string",
          "minLength": 1
        },
        "ddr": {
          "description": "Distrito de Desarrollo Rural (SIAP), si aplica.",
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entradas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entrada"
      }
    },
    "advertencias": {
      "type": "array",
      "items": {
        "$ref": "comun.schema.json#/$defs/advertencia"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ventanaCitada": {
      "title": "VentanaSiembraCitada",
      "type": "object",
      "required": [
        "estado",
        "desdeMes",
        "hastaMes",
        "fuente"
      ],
      "properties": {
        "estado": {
          "const": "EVALUABLE"
        },
        "desdeMes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "hastaMes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "desdeDia": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hastaDia": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "fuente": {
          "$ref": "comun.schema.json#/$defs/fuente"
        }
      },
      "additionalProperties": false
    },
    "presenciaLocal": {
      "title": "PresenciaLocal",
      "description": "Si la fuente registra el cultivo en el lugar (por ejemplo, superficie sembrada en SIAP en un periodo). no_registrado permite mostrar el cultivo sin recomendarlo.",
      "type": "object",
      "required": [
        "estado",
        "fuente"
      ],
      "properties": {
        "estado": {
          "type": "string",
          "enum": [
            "registrado",
            "no_registrado",
            "sin_dato"
          ]
        },
        "periodo": {
          "$ref": "comun.schema.json#/$defs/periodo"
        },
        "fuente": {
          "$ref": "comun.schema.json#/$defs/fuente"
        },
        "nota": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entrada": {
      "title": "EntradaCalendario",
      "type": "object",
      "required": [
        "cultivo",
        "temporada",
        "regimen",
        "estado",
        "ventana",
        "presencia"
      ],
      "properties": {
        "cultivo": {
          "$ref": "comun.schema.json#/$defs/idCultivo"
        },
        "temporada": {
          "$ref": "comun.schema.json#/$defs/temporada"
        },
        "regimen": {
          "type": "string",
          "enum": [
            "temporal",
            "riego"
          ]
        },
        "estado": {
          "$ref": "comun.schema.json#/$defs/estado"
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "ventana": {
          "oneOf": [
            {
              "$ref": "#/$defs/ventanaCitada"
            },
            {
              "$ref": "comun.schema.json#/$defs/valorNoEvaluable"
            }
          ]
        },
        "presencia": {
          "$ref": "#/$defs/presenciaLocal"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "estado": {
            "not": {
              "const": "EVALUABLE"
            }
          }
        },
        "required": [
          "estado"
        ]
      },
      "then": {
        "required": [
          "motivo"
        ]
      }
    }
  }
}
